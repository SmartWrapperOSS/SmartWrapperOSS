# Copy this file to config/config.yaml and fill in your own API keys.
# config/config.yaml is gitignored — never commit real API keys.

# --- Models available to run/judge with ---
# Add or remove entries here to control which models SmartWrapperOSS can use.
# "id" must match the --models value you pass on the CLI.
models:
  - id: gpt-4o
    provider: openai
    api_key: "YOUR_OPENAI_API_KEY"

  - id: claude-sonnet-4-6
    provider: anthropic
    api_key: "YOUR_ANTHROPIC_API_KEY"

  - id: gemini-3.5-flash
    provider: google
    api_key: "YOUR_GOOGLE_API_KEY"

  # --- Open-weight / local / third-party models ---
  # `provider: openai_compatible` works with ANY endpoint that implements
  # the OpenAI chat-completions wire format. That covers local runtimes
  # (Ollama, vLLM, LM Studio, llama.cpp server, text-generation-webui) and
  # hosted OSS-model APIs (Together, Groq, Fireworks, OpenRouter) alike —
  # so Mistral, Qwen, DeepSeek, etc. are all just an entry here,
  # not new code. Fields:
  #   base_url            required. The endpoint's OpenAI-compatible root
  #                        (must include the /v1 suffix most runtimes use).
  #   api_model            optional. The model name to send on the wire, if
  #                        different from `id` above (e.g. Ollama's
  #                        "llama3.3:70b" tag vs. a friendlier `id` here).
  #                        Defaults to `id` if omitted.
  #   api_key              optional. Most local servers ignore it; hosted
  #                        APIs (Together, Groq, OpenRouter, ...) require a
  #                        real key. Omit for a no-auth local server.
  #   cost_per_1k_input/
  #   cost_per_1k_output   optional. Overrides the router's built-in price
  #                        table. Set both to 0 for a local model with no
  #                        API cost (the default if omitted); set real
  #                        rates for a hosted OSS-model API that charges.
  #   max_tokens           optional. Defaults to 1000.
  #   timeout              optional, in seconds. Defaults to 120. Local
  #                        models on modest hardware can be much slower
  #                        to respond than a cloud API — raise this for
  #                        large models rather than have runs fail.
  #   extra_params         optional dict, passed straight through into the
  #                        request body. For runtime-specific fields the
  #                        OpenAI spec doesn't have, e.g. Ollama's
  #                        `keep_alive` (how long it keeps the model
  #                        loaded in memory between calls).
  #
  # Any number of local models can be listed side by side, each scored as
  # its own row — they don't have to share one entry or one name.

  # Example: several local models served by Ollama (`ollama serve`, then
  # `ollama pull <model>` for each one first). All share the same default
  # Ollama port, so only `api_model` differs.
  #
  # NOTE for memory-constrained machines (e.g. 16GB unified memory): don't
  # pass more than one of these in the same --models run, and start Ollama
  # with OLLAMA_MAX_LOADED_MODELS=1 so it evicts the previous model before
  # loading the next rather than trying to hold several in RAM at once —
  # SmartWrapperOSS's thread pool can otherwise fire several models'
  # worth of requests concurrently. `keep_alive` below is set low (not
  # the "10m" you might otherwise want) so a model is actually freed
  # between calls instead of competing with the next one for memory.
  - id: qwen2.5:7b
    provider: openai_compatible
    base_url: "http://localhost:11434/v1"
    api_model: "qwen2.5:7b"
    cost_per_1k_input: 0.0
    cost_per_1k_output: 0.0
    extra_params:
      keep_alive: "1m"

  - id: mistral:7b
    provider: openai_compatible
    base_url: "http://localhost:11434/v1"
    api_model: "mistral:7b"
    cost_per_1k_input: 0.0
    cost_per_1k_output: 0.0
    extra_params:
      keep_alive: "1m"

  - id: gemma2:9b
    provider: openai_compatible
    base_url: "http://localhost:11434/v1"
    api_model: "gemma2:9b"
    cost_per_1k_input: 0.0
    cost_per_1k_output: 0.0
    extra_params:
      keep_alive: "1m"


# --- GCS settings (only used by the "summarize" workflow) ---
gcs:
  credentials_path: "gcp-credentials.json"   # path to your service account key

# --- Chunking settings (only used by the "summarize" workflow) ---
chunking:
  chunk_size: 1000      # words per chunk
  chunk_overlap: 100     # words of overlap between chunks

# --- Evaluation settings ---
evaluation:
  # Which model judges the subjective summarization dimensions
  # (Quality / Coverage / Conciseness). The anti-bias rule in
  # SummarizationEvaluator automatically avoids using this judge to
  # score its own output — see workflows/summarization/evaluator.py.
  judge_model: claude-sonnet-4-6

  # Optional: override the default weights for each workflow's composite
  # score. Omit either block to use the workflow's built-in defaults.
  summarization_weights:
    quality: 0.35
    coverage: 0.30
    conciseness: 0.15
    latency: 0.10
    cost: 0.10

  tool_use_weights:
    tool_selection: 0.25
    argument_correctness: 0.25
    task_completion: 0.25
    efficiency: 0.10
    latency: 0.075
    cost: 0.075

# --- Output settings ---
output:
  show_reasons: true               # print judge/scoring reasons under each row
  # Output files are always named results_<workflow>.json /
  # results_<workflow>.html (e.g. results_summarize.json,
  # results_tool-use.html) so running multiple workflows doesn't
  # overwrite each other's output. Not configurable.
  html_dashboard: true             # also generate a browsable results.html (no server needed)

# --- Optional: override built-in prompts ---
# Omit this whole section to use each workflow's default, built-in prompts.
# Only override what you want to test — any field you leave out falls back
# to its default. This is useful for testing how prompt wording affects
# scores without editing source code.
#
# IMPORTANT: keep the exact {placeholder} names shown below — they're
# filled in automatically at run time. Removing a placeholder will cause
# an error; adding extra text around them is fine.
#
# prompts:
#   summarize:
#     summarize_prompt: |
#       You are a document summarization assistant.
#       Summarize the following document in no more than 3 sentences.
#
#       DOCUMENT:
#       {document}
#     review_prompt: |
#       Review this summary against the source. Return only the improved
#       summary, with no preamble.
#
#       ORIGINAL:
#       {document}
#
#       SUMMARY:
#       {draft}
#
#   tool_use:
#     agent_prompt: |
#       You are a careful assistant that can call tools to complete tasks.
#       Always double-check your arguments before calling a tool.
#
#       TASK:
#       {prompt}
#
#       AVAILABLE TOOLS:
#       {tool_descriptions}
#
#       CONVERSATION SO FAR:
#       {history}
#
#       Respond with ONLY valid JSON in ONE of these two forms:
#       To call a tool: {{"action": "call_tool", "tool": "<tool_name>", "args": {{...}}}}
#       When done: {{"action": "final_answer", "answer": "<your final answer>"}}
